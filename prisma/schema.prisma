generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Role {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  is_admin_role Boolean           @default(false)
  description   String?
  permissions   AdminPermission[]
  users         User[]

  @@map("roles")
}

model AdminPermission {
  id         Int      @id @default(autoincrement())
  role_id    Int
  module     String
  can_view   Boolean  @default(false)
  can_create Boolean  @default(false)
  can_edit   Boolean  @default(false)
  can_delete Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, module])
  @@index([role_id])
  @@map("admin_permissions")
}

model User {
  id                              Int                   @id @default(autoincrement())
  email                           String                @unique
  password                        String
  role_id                         Int
  created_at                      DateTime              @default(now())
  updated_at                      DateTime              @updatedAt
  created_by                      Int?
  is_super_admin                  Boolean               @default(false)
  driver_create_requests          DriverCreateRequest[]
  reviewed_driver_create_requests DriverCreateRequest[] @relation("DriverCreateRequestReviewer")
  driver                          Driver?
  notifications                   NotificationHistory[]
  passenger                       Passenger?
  deviceTokens                    UserDeviceToken[]
  role                            Role                  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@map("users")
}

model NotificationHistory {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String
  body       String
  data       Json?
  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("notification_histories")
}

model UserDeviceToken {
  id           Int      @id @default(autoincrement())
  user_id      Int
  device_token String   @unique
  platform     String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active])
  @@map("user_device_tokens")
}

model Company {
  id              Int              @id @default(autoincrement())
  name            String
  email           String?
  phone_no        String?
  address         String
  lat             Float?
  long            Float?
  weekly_off_days Weekday[]        @default([])
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  holidays        CompanyHoliday[]
  passengers      Passenger[]
  routes          Route[]

  @@map("companies")
}

model Car {
  id                     Int                         @id @default(autoincrement())
  name                   String
  engine_capacity        String
  model                  String
  car_no                 String
  car_color              String
  fuel_per_km            String?
  car_front_image_url    String
  car_back_image_url     String
  car_front_card_url     String
  car_back_card_url      String
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  driver_assign_cars     DriverAssignCar[]
  selected_phase_drivers RouteDailyPlanPhaseDriver[] @relation("SelectedTripCar")

  @@map("cars")
}

model Driver {
  id                       Int                         @id @default(autoincrement())
  user_id                  Int?                        @unique
  name                     String
  phone_no                 String?
  address                  String
  emergency_phone_no       String
  driver_image_url         String
  rate_per_km              Float
  driver_cnic_front_url    String
  driver_cnic_back_url     String
  driver_license_front_url String
  driver_license_back_url  String
  status                   DriverApprovalStatus        @default(APPROVED)
  is_available             Boolean                     @default(false)
  available_at             DateTime?
  home_lat                 Float?
  home_long                Float?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt
  driver_assign_cars       DriverAssignCar[]
  create_requests          DriverCreateRequest[]
  leaves                   DriverLeave[]
  user                     User?                       @relation(fields: [user_id], references: [id])
  daily_plan_phase_drivers RouteDailyPlanPhaseDriver[]
  issue_reports            RouteIssueReport[]
  routes                   Route[]

  @@map("drivers")
}

model DriverCreateRequest {
  id                   Int       @id @default(autoincrement())
  requested_by_user_id Int?
  payload              Json
  status               String    @default("PENDING")
  reviewed_by_user_id  Int?
  reviewed_at          DateTime?
  review_note          String?
  created_driver_id    Int?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  created_driver       Driver?   @relation(fields: [created_driver_id], references: [id])
  requested_by_user    User?     @relation(fields: [requested_by_user_id], references: [id])
  reviewed_by_user     User?     @relation("DriverCreateRequestReviewer", fields: [reviewed_by_user_id], references: [id])

  @@index([status, created_at])
  @@map("driver_create_requests")
}

model DriverAssignCar {
  id         Int      @id @default(autoincrement())
  driver_id  Int
  car_id     Int
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  car        Car      @relation(fields: [car_id], references: [id], onDelete: Cascade)
  driver     Driver   @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@unique([driver_id, car_id])
  @@map("driver_assign_cars")
}

model Passenger {
  id                                Int                            @id @default(autoincrement())
  user_id                           Int?                           @unique
  name                              String
  email                             String?
  phone_no                          String
  home_address                      String?
  home_lat                          Float?
  home_long                         Float?
  office_address                    String
  office_lat                        Float?
  office_long                       Float?
  company_id                        Int
  pick_up_time                      String?
  home_pick_up_time                 String?
  drop_off_time                     String?
  office_pick_up_time               String?
  created_at                        DateTime                       @default(now())
  updated_at                        DateTime                       @updatedAt
  company                           Company                        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user                              User?                          @relation(fields: [user_id], references: [id])
  route_daily_plan_phase_passengers RouteDailyPlanPhasePassenger[]
  routeLegs                         RouteLeg[]

  @@map("passengers")
}

model DriverConfiguration {
  id                             Int      @id @default(autoincrement())
  availability_time              String
  still_waiting_button_appear_in String
  remaining_start_time           String
  passenger_waiting_time         String
  skip_button_appear_in          String
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  @@map("driver_configurations")
}

model Route {
  id                   Int                @id @default(autoincrement())
  company_id           Int
  driver_id            Int
  office_address       String
  office_lat           Float
  office_long          Float
  recurring_plan_start DateTime?          @db.Date
  recurring_plan_end   DateTime?          @db.Date
  route_daily_plan_id  Int?               @unique
  route_price          Float?
  is_active            Boolean            @default(true)
  waypointMode         WaypointMode       @default(auto) @map("waypoint_mode")
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  batches              RouteBatch[]
  defined_plans        RouteDailyPlan[]   @relation("RouteDefinitionPlans")
  issue_reports        RouteIssueReport[]
  legs                 RouteLeg[]
  segments             RouteSegment[]
  company              Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  driver               Driver             @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  daily_plan           RouteDailyPlan?    @relation("PlanExecutionRoute", fields: [route_daily_plan_id], references: [id], onDelete: Cascade)

  @@index([driver_id])
  @@map("routes")
}

model RouteIssueReport {
  id         Int      @id @default(autoincrement())
  route_id   Int
  driver_id  Int
  image_url  String
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  driver     Driver   @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@index([route_id, created_at])
  @@index([driver_id, created_at])
  @@map("route_issue_reports")
}

model RouteDailyPlan {
  id                  Int                         @id @default(autoincrement())
  definition_route_id Int
  scheduled_date      DateTime                    @db.Date
  status              RouteStatus                 @default(PENDING)
  started_at          DateTime?
  completed_at        DateTime?
  created_at          DateTime                    @default(now())
  updated_at          DateTime                    @updatedAt
  phase_drivers       RouteDailyPlanPhaseDriver[]
  definition_route    Route                       @relation("RouteDefinitionPlans", fields: [definition_route_id], references: [id], onDelete: Cascade)
  execution_route     Route?                      @relation("PlanExecutionRoute")

  @@unique([definition_route_id, scheduled_date])
  @@index([scheduled_date])
  @@map("route_daily_plans")
}

model CompanyHoliday {
  id         Int      @id @default(autoincrement())
  company_id Int
  date       DateTime @db.Date
  name       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, date])
  @@map("company_holidays")
}

model DriverLeave {
  id         Int      @id @default(autoincrement())
  driver_id  Int
  date       DateTime @db.Date
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  driver     Driver   @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@unique([driver_id, date])
  @@map("driver_leaves")
}

model RouteBatch {
  id                         Int            @id @default(autoincrement())
  route_id                   Int
  batch_order                Int
  pickup_directions_polyline String?
  pickup_waypoint_order      Json?
  pickup_directions_legs     Json?
  pickup_distance_meters     Int?
  pickup_duration_seconds    Int?
  pickup_updated_at          DateTime?
  drop_directions_polyline   String?
  drop_waypoint_order        Json?
  drop_directions_legs       Json?
  drop_distance_meters       Int?
  drop_duration_seconds      Int?
  drop_updated_at            DateTime?
  route                      Route          @relation(fields: [route_id], references: [id], onDelete: Cascade)
  legs                       RouteLeg[]
  segments                   RouteSegment[]

  @@unique([route_id, batch_order])
  @@map("route_batches")
}

model RouteSegment {
  id            Int           @id @default(autoincrement())
  route_id      Int
  segment_order Int
  batch_id      Int
  kind          SegmentKind
  status        SegmentStatus @default(PENDING)
  batch         RouteBatch    @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  route         Route         @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@unique([route_id, segment_order])
  @@map("route_segments")
}

model RouteLeg {
  id                  Int        @id @default(autoincrement())
  route_id            Int
  batch_id            Int
  passenger_id        Int
  sequence            Int        @default(0)
  drop_sequence       Int        @default(0)
  pickup_address      String
  pickup_lat          Float
  pickup_long         Float
  pickup_time         String
  dropoff_address     String
  dropoff_lat         Float
  dropoff_long        Float
  dropoff_time        String
  office_pick_up_time String?
  toll_amount         Float?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  batch               RouteBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  passenger           Passenger  @relation(fields: [passenger_id], references: [id], onDelete: Cascade)
  route               Route      @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@map("route_legs")
}

model RouteDailyPlanPhaseDriver {
  id                                Int                            @id @default(autoincrement())
  route_daily_plan_id               Int
  phase                             RouteDailyPlanPhase
  driver_id                         Int
  scheduled_date                    DateTime                       @db.Date
  trip_start_time                   String?
  trip_started_at                   DateTime?
  status                            RouteStatus                    @default(PENDING)
  trip_price                        Float?
  selected_car_id                   Int?
  trip_km                           Float?
  fuel_price_per_liter_snapshot     Float?
  km_per_liter_snapshot             Float?
  fuel_cost                         Float?
  salary_payment_status             PaymentStatus                  @default(UNPAID)
  fuel_payment_status               PaymentStatus                  @default(UNPAID)
  salary_paid_at                    DateTime?
  fuel_paid_at                      DateTime?
  availability_missed_at            DateTime?
  availability_miss_notified_at     DateTime?
  availability_admin_override_until DateTime?
  trip_start_reminder_sent_at       DateTime?
  created_at                        DateTime                       @default(now())
  updated_at                        DateTime                       @updatedAt
  driver                            Driver                         @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  route_daily_plan                  RouteDailyPlan                 @relation(fields: [route_daily_plan_id], references: [id], onDelete: Cascade)
  selected_car                      Car?                           @relation("SelectedTripCar", fields: [selected_car_id], references: [id])
  route_daily_plan_phase_passengers RouteDailyPlanPhasePassenger[]

  @@unique([route_daily_plan_id, phase])
  @@index([driver_id])
  @@index([driver_id, scheduled_date])
  @@map("route_daily_plan_phase_drivers")
}

model FuelPrice {
  id              Int      @id @default(autoincrement())
  price_per_liter Float
  effective_from  DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([effective_from])
  @@map("fuel_prices")
}

model RouteDailyPlanPhasePassenger {
  id                               Int                       @id @default(autoincrement())
  route_daily_plan_phase_driver_id Int
  passenger_id                     Int
  status                           PhasePassengerStatus      @default(PENDING)
  driver_arrived_at                DateTime?
  passenger_waiting_notified_at    DateTime?
  still_waiting_phase_notified_at  DateTime?
  skip_phase_notified_at           DateTime?
  move_next_notified_at            DateTime?
  passenger_ack                    PassengerAck?
  picked_at                        DateTime?
  picked_lat                       Float?
  picked_long                      Float?
  dropoff_arrived_at               DateTime?
  dropped_at                       DateTime?
  created_at                       DateTime                  @default(now())
  updated_at                       DateTime                  @updatedAt
  passenger                        Passenger                 @relation(fields: [passenger_id], references: [id], onDelete: Cascade)
  route_daily_plan_phase_driver    RouteDailyPlanPhaseDriver @relation(fields: [route_daily_plan_phase_driver_id], references: [id], onDelete: Cascade)

  @@map("route_daily_plan_phase_passengers")
}

enum PhasePassengerStatus {
  PENDING
  ARRIVED
  PICKED
  SKIPPED
  DROPPED
  STILL_WAITING
  MOVE_TO_NEXT
}

enum PassengerAck {
  COMING
  NOT_COMING
}

enum SegmentKind {
  PICKUP_TO_OFFICE
  DROP_TO_HOMES
}

enum SegmentStatus {
  PENDING
  ONGOING
  COMPLETED
}

enum RouteStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

enum RouteDailyPlanPhase {
  PICKUP
  DROP
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

/** Pickup/drop ordering strategy for a route definition. */
enum WaypointMode {
  auto
  manual
}
