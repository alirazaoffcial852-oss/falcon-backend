{
  "name": "falcon-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev src/app.ts",
    "build": "tsc && node scripts/copy-prisma-to-dist.cjs",
    "start": "node dist/app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "pnpm exec ts-node prisma/seed.ts",
    "seed:setup": "pnpm exec ts-node prisma/seed-setup.ts",
    "db:setup": "prisma migrate reset --force --skip-seed && pnpm run seed:setup",
    "db:reset": "pnpm exec ts-node prisma/reset.ts",
    "diagnose:passenger-push": "pnpm exec ts-node scripts/diagnose-passenger-push.ts",
    "postinstall": "pnpm run prisma:generate"
  },
  "prisma": {
    "seed": "pnpm exec ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.1",
    "firebase-admin": "^13.7.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "node-cron": "^4.2.1",
    "prisma": "^6.19.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "socket.io-parser": "^4.2.6",
      "path-to-regexp": "^8.4.0",
      "effect": "^3.20.0",
      "lodash": "^4.18.0",
      "picomatch": "^2.3.2",
      "brace-expansion": "^1.1.13"
    }
  }
